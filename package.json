{
  "name": "modular-programming",
  "private": true,
  "workspaces": [
    "sample-service",
    "sample-nest-service",
    "fixtures/frameworks",
    "analyzer",
    "ui"
  ],
  "scripts": {
    "analyze": "npm run analyze --workspace analyzer --",
    "dev": "npm run dev --workspace ui",
    "demo": "npm run demo --workspace analyzer && npm run dev --workspace ui",
    "check": "npm run typecheck --workspaces --if-present",
    "live": "npm run live --workspace analyzer --"
  }
}
