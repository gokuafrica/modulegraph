diff --git a/sample-service/src/modules/personal-details/PersonalDetailsModule.ts b/sample-service/src/modules/personal-details/PersonalDetailsModule.ts
index 4678980..9e8f7fc 100644
--- a/sample-service/src/modules/personal-details/PersonalDetailsModule.ts
+++ b/sample-service/src/modules/personal-details/PersonalDetailsModule.ts
@@ -1,24 +1,44 @@
 import { Db } from '../../platform/db.ts';
+import { Outbox } from '../../platform/outbox.ts';
+import { IdentityModule } from '../identity/IdentityModule.ts';
 import type { IdentityData } from '../identity/types.ts';
 
 export interface PersonalDetails {
   legalName: string;
   preferredName: string;
   dateOfBirth: string;
+  /** When the user last changed their preferred name. */
+  preferredNameUpdatedAt?: string;
 }
 
 /**
  * Legal name and date of birth from documents, preferred name from the user's profile.
  */
 export class PersonalDetailsModule {
-  constructor(private readonly db: Db) {}
+  constructor(
+    private readonly db: Db,
+    private readonly identity: IdentityModule,
+    private readonly outbox: Outbox,
+  ) {}
 
   async resolve(userId: string, identity: IdentityData): Promise<PersonalDetails> {
     const [profile] = await this.db.select('user_profiles', { userId });
+    // Documents uploaded after the identity was fetched may have a better legal name.
+    const latest = identity.fullName ? identity : await this.identity.fetchIdentity(userId);
+    await this.db.update('user_profiles', { userId }, { lastResolvedAt: new Date().toISOString() });
     return {
-      legalName: identity.fullName,
-      preferredName: (profile?.preferredName as string | undefined) ?? identity.fullName,
-      dateOfBirth: identity.dateOfBirth,
+      legalName: latest.fullName,
+      preferredName: (profile?.preferredName as string | undefined) ?? latest.fullName,
+      dateOfBirth: latest.dateOfBirth,
+      preferredNameUpdatedAt: profile?.preferredNameUpdatedAt as string | undefined,
     };
   }
+
+  async updatePreferredName(userId: string, preferredName: string): Promise<PersonalDetails> {
+    const trimmed = preferredName.trim().slice(0, 80);
+    await this.db.update('user_profiles', { userId }, { preferredName: trimmed, preferredNameUpdatedAt: new Date().toISOString() });
+    await this.outbox.enqueue('profile.preferred_name_changed', { userId, preferredName: trimmed });
+    const identity = await this.identity.fetchIdentity(userId);
+    return this.resolve(userId, identity);
+  }
 }
