{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://modulegraph.dev/schema/modulegraph-v1.json",
  "title": "modulegraph/v1",
  "description": "Module-level review graph: modules, operations, entry points, scopes (flows), findings. Generated from schema/modulegraph.ts.",
  "$ref": "#/definitions/ModuleGraph",
  "definitions": {
    "EffectKind": {
      "type": "string",
      "enum": [
        "db.read",
        "db.write",
        "outbox",
        "kafka",
        "http",
        "queue",
        "event"
      ]
    },
    "ChangeStatus": {
      "type": "string",
      "enum": [
        "added",
        "modified",
        "removed",
        "unchanged"
      ]
    },
    "EntryKind": {
      "type": "string",
      "enum": [
        "api",
        "grpc",
        "consumer",
        "cron",
        "queue",
        "event"
      ]
    },
    "Risk": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    "GapReason": {
      "type": "string",
      "enum": [
        "function-value",
        "interface-dispatch",
        "untyped",
        "dynamic"
      ]
    },
    "Effect": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/EffectKind"
        },
        "target": {
          "type": "string",
          "description": "Table name, outbox event type, Kafka topic or external service name."
        },
        "lock": {
          "type": "string",
          "description": "A read that locks the rows it reads: `for update` (pessimistic write), `for share` (pessimistic read)."
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "additionalProperties": false
    },
    "Gap": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "reason": {
          "$ref": "#/definitions/GapReason"
        }
      },
      "required": [
        "file",
        "line",
        "reason"
      ],
      "additionalProperties": false
    },
    "ExplainEntry": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "step",
            "inlined",
            "external",
            "followed",
            "gap"
          ]
        },
        "to": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/GapReason"
        }
      },
      "required": [
        "file",
        "line",
        "text",
        "disposition"
      ],
      "additionalProperties": false
    },
    "Disagreement": {
      "type": "object",
      "properties": {
        "line": {
          "type": "number"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "line",
        "note"
      ],
      "additionalProperties": false
    },
    "Param": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "What it is, from the code's own documentation (a field's JSDoc, `@ApiProperty({ description })`)."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Param"
          },
          "description": "One level of documented fields, for an input whose type is a documented class (a DTO)."
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "TypeShape": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Param"
          },
          "description": "One level of fields when the type is an object."
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "ModuleGraph": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "modulegraph/v1"
        },
        "service": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/Source"
        },
        "modules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ModuleInfo"
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Operation"
          }
        },
        "entryPoints": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/EntryPoint"
          }
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Scope"
          },
          "description": "Keyed by operation id or entry point id."
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Finding"
          }
        },
        "review": {
          "$ref": "#/definitions/ReviewSummary"
        },
        "lazy": {
          "$ref": "#/definitions/LazyInfo",
          "description": "Present when the graph was built lazily: only what the review needed so far."
        },
        "incomplete": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnalysisIssue"
          },
          "description": "Why the analysis may have missed things (packages that don't resolve, calls it couldn't follow, changed code it\ncouldn't place). Present and non-empty = the review is incomplete: \"no findings\" does not mean \"safe\"."
        }
      },
      "required": [
        "schema",
        "service",
        "generatedAt",
        "generator",
        "source",
        "modules",
        "operations",
        "entryPoints",
        "scopes",
        "findings",
        "review"
      ],
      "additionalProperties": false
    },
    "AnalysisIssue": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "unresolved-imports",
            "unresolved-calls",
            "unmapped-change",
            "missing-entry-points",
            "unknown-side-effects",
            "invariant"
          ],
          "description": "`unresolved-imports`: packages the code imports are not installed, so library calls (and their side effects)\ncan't be recognised. `unresolved-calls`: many calls on injected dependencies resolve to nothing.\n`unmapped-change`: changed code that is in no flow the analyzer knows (a framework it doesn't model).\n`missing-entry-points`: signs of entry points the analysis did not find (a Kafka client but no consumer, a handler\nmap, scripts that start the app with an argument). `unknown-side-effects`: packages that look like messaging,\noutbox or cloud clients, which no adapter or profile rule describes, so their calls are not side effects.\n`invariant`: a property every correct review has does not hold here (an effect that names no target, an entry\npoint listed twice, …), scoped to the operation or entry point it is about."
        },
        "scope": {
          "type": "string",
          "description": "The operation or entry point it is about, when it is about one."
        },
        "message": {
          "type": "string",
          "description": "One line, for the CLI and the top of the brief."
        },
        "hint": {
          "type": "string",
          "description": "What to do about it."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Packages, call sites or changed functions, a few at most."
        },
        "side": {
          "type": "string",
          "enum": [
            "head",
            "base"
          ],
          "description": "Which revision it was found on."
        },
        "suggestion": {
          "type": "string",
          "description": "Profile JSON that fixes it (keys of `modulegraph.config.json`), when the analysis can say what it would be."
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "additionalProperties": false
    },
    "PipelineItem": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "middleware",
            "guard",
            "interceptor",
            "pipe",
            "filter",
            "metadata"
          ]
        },
        "name": {
          "type": "string",
          "description": "Class name, or the decorator as written for metadata (`@Roles(['admin'])`)."
        },
        "scope": {
          "type": "string",
          "enum": [
            "global",
            "controller",
            "method"
          ],
          "description": "Where it is applied: app-wide, on the controller class, or on the handler method."
        },
        "file": {
          "type": "string",
          "description": "Where it is applied (the decorator, the `useGlobalGuards` call, the provider, the middleware chain)."
        },
        "line": {
          "type": "number"
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The service's own functions it runs (`AuthGuard.canActivate` and helpers it calls), when the flow was analyzed."
        }
      },
      "required": [
        "kind",
        "name",
        "scope"
      ],
      "additionalProperties": false
    },
    "LazyInfo": {
      "type": "object",
      "properties": {
        "api": {
          "type": "string",
          "description": "Where the live analysis server answers expand requests, relative to the UI (\"/api\"). Absent = static file."
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "reason"
            ],
            "additionalProperties": false
          },
          "description": "Entry points analyzed up front, and why each was picked."
        },
        "stats": {
          "type": "object",
          "properties": {
            "entryPointsKnown": {
              "type": "number"
            },
            "entryPointsAnalyzed": {
              "type": "number",
              "description": "Flow fully analyzed (handler and everything below it)."
            },
            "entryPointsReached": {
              "type": "number",
              "description": "Known to reach the change, flow not analyzed yet."
            },
            "operationsKnown": {
              "type": "number"
            },
            "operationsAnalyzed": {
              "type": "number"
            },
            "ms": {
              "type": "number",
              "description": "Milliseconds spent on analysis so far (initial + expansions)."
            }
          },
          "required": [
            "entryPointsKnown",
            "entryPointsAnalyzed",
            "entryPointsReached",
            "operationsKnown",
            "operationsAnalyzed",
            "ms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "seeds",
        "stats"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "snapshot",
            "uncommitted",
            "branch",
            "pr"
          ]
        },
        "repo": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "workingTree": {
          "type": "boolean",
          "description": "The head side is the working tree, not a commit: `head`'s last commit plus uncommitted edits in the checkout\n(a PR being fixed locally, or --uncommitted)."
        },
        "title": {
          "type": "string"
        },
        "intent": {
          "type": "string",
          "description": "Stated intent (PR description). Used to flag undisclosed side effects."
        },
        "intentSource": {
          "type": "string",
          "enum": [
            "flag",
            "pr",
            "commits"
          ],
          "description": "Where the intent came from: the --intent flag, the PR description, or the branch's commit messages."
        },
        "profile": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "exists": {
              "type": "boolean"
            },
            "unmatched": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "registries": {
              "type": "number"
            }
          },
          "required": [
            "path",
            "exists"
          ],
          "additionalProperties": false,
          "description": "The service profile this review used, or where to create one (`exists: false`), with the home folder as `~`:\nwhere descriptions and rules go. The UI names it in its \"add a description\" hints. The service profile this review read (or would read). `unmatched`: descriptions in it that name no class or\nmethod of the service (a typo, or a display name instead of the class name): they are not shown anywhere. The service's profile. `registries`: how many `entryRegistries` rules it has (their handler classes are counted as\nentry points, not modules, so a run with them counts fewer modules than one without, for the same code)."
        },
        "disagreements": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "number"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "line",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "description": "The agent's blind check, from the profile (`disagreements`): `Class.method` → where it disagrees with the diagram."
        },
        "command": {
          "type": "string",
          "description": "The command that analyzes this review again, live (`modulegraph review …`): shown when the review is only a saved file."
        },
        "analyzer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "frameworks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "id",
            "language",
            "frameworks"
          ],
          "additionalProperties": false,
          "description": "Which backend produced the graph and which framework adapters it used."
        },
        "examples": {
          "type": "object",
          "properties": {
            "scenario": {
              "type": "string",
              "description": "The scenario file; for `kind: tests`, \"unit tests (mocked dependencies)\"."
            },
            "kind": {
              "type": "string",
              "enum": [
                "scenario",
                "tests"
              ],
              "description": "`scenario`: a profile's scenario.ts (real calls). `tests`: the service's own specs, whose data comes from mocks."
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "`tests`: the spec files that ran, relative to the project folder, and how many tests they have."
            },
            "tests": {
              "type": "number"
            },
            "timedOut": {
              "type": "boolean",
              "description": "`tests`: the run hit its time limit (`--tests-timeout`), so some cases are missing."
            },
            "timeoutSeconds": {
              "type": "number"
            },
            "note": {
              "type": "string",
              "description": "Why nothing was recorded, when nothing was."
            },
            "operationsCovered": {
              "type": "number"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ExampleCase"
              },
              "description": "The scenario's requests whose calls are shown. Every example names its case, so one request can be followed through every module."
            }
          },
          "required": [
            "scenario",
            "operationsCovered"
          ],
          "additionalProperties": false,
          "description": "Scenario (or the service's tests) run against the head revision to capture example inputs/outputs."
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FileChange"
          }
        }
      },
      "required": [
        "mode",
        "repo",
        "project",
        "files"
      ],
      "additionalProperties": false
    },
    "FileChange": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed"
          ]
        },
        "added": {
          "type": "number"
        },
        "removed": {
          "type": "number"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Modules whose code lives in this file. Empty = change not attributed to any module."
        }
      },
      "required": [
        "path",
        "status",
        "added",
        "removed",
        "modules"
      ],
      "additionalProperties": false
    },
    "ModuleInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Display name, e.g. \"BirthInfo\"."
        },
        "className": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "summary": {
          "type": "string"
        },
        "summarySource": {
          "type": "string",
          "enum": [
            "code",
            "profile"
          ],
          "description": "Where the summary came from: the code's doc comment, or the service profile (often written by the review agent)."
        },
        "owner": {
          "type": "string"
        },
        "declaredEffects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          },
          "description": "Side effects declared for the module (external config, or opt-in `@effect` tags). Empty when none are declared."
        },
        "contractSource": {
          "type": "string",
          "enum": [
            "config",
            "tags"
          ],
          "description": "Where declarations came from. Absent = nothing declared, so the undeclared-effect rule doesn't apply."
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "change": {
          "$ref": "#/definitions/ChangeStatus"
        }
      },
      "required": [
        "id",
        "name",
        "className",
        "file",
        "line",
        "summary",
        "declaredEffects",
        "operations",
        "change"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "moduleId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "endLine": {
          "type": "number"
        },
        "summary": {
          "type": "string",
          "description": "What the operation does, in a sentence or two."
        },
        "summarySource": {
          "type": "string",
          "enum": [
            "code",
            "profile",
            "api",
            "class"
          ],
          "description": "Where the summary comes from, best first: `code` the method's doc comment; `profile` written in the service\nprofile (usually by the review agent); `api` the API documentation of the entry point that hands the request to\nthis operation (`@ApiOperation`); `class` the doc comment of the operation's class."
        },
        "summaryFrom": {
          "type": "string",
          "description": "For `api`: which entry point's documentation, e.g. `@ApiOperation on PUT /api/v1/…`."
        },
        "context": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "summary"
          ],
          "additionalProperties": false,
          "description": "No description of its own, but a described operation only hands over to this one (controller → facade → worker):\nthat operation and its description, shown as \"called through …\". Not this operation's description."
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Param"
          }
        },
        "returns": {
          "$ref": "#/definitions/TypeShape"
        },
        "directEffects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          },
          "description": "Effects performed by this operation itself (incl. inlined non-module helpers)."
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          },
          "description": "Direct + everything reachable through called operations."
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Operation ids called directly."
        },
        "change": {
          "$ref": "#/definitions/ChangeStatus"
        },
        "containsChanges": {
          "type": "boolean",
          "description": "True when this op or anything it reaches changed. Tells the reviewer to drill in."
        },
        "delta": {
          "$ref": "#/definitions/ContractDelta"
        },
        "diff": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiffLine"
          },
          "description": "Line diff of this operation's own method (base vs head), when changed."
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CodeChange"
          },
          "description": "Every changed function behind this operation: its own method plus inlined helpers, possibly in other files."
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Example"
          },
          "description": "Real calls recorded while running the scenario on the head revision: one per distinct input/output."
        },
        "source": {
          "type": "string"
        },
        "lazy": {
          "type": "object",
          "properties": {
            "callersLoaded": {
              "type": "boolean"
            },
            "calleesLoaded": {
              "type": "boolean"
            }
          },
          "required": [
            "callersLoaded",
            "calleesLoaded"
          ],
          "additionalProperties": false,
          "description": "Lazy analyses only: whether callers (up) and callees (down) of this operation have been analyzed."
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Gap"
          },
          "description": "Calls in it (helpers included) the analysis can't follow: what they do is not shown."
        },
        "disagreements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Disagreement"
          },
          "description": "The agent's blind check disagrees with the diagram here (profile `disagreements`). Steps are never changed by it."
        }
      },
      "required": [
        "id",
        "moduleId",
        "name",
        "file",
        "line",
        "endLine",
        "params",
        "returns",
        "directEffects",
        "effects",
        "calls",
        "change",
        "containsChanges",
        "source"
      ],
      "additionalProperties": false
    },
    "ExampleCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "Example": {
      "type": "object",
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "string"
          },
