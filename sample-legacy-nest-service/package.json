{
  "name": "user-records-service",
  "version": "3.14.0",
  "private": true,
  "description": "Manual review of user records (demo for modulegraph: shaped like a mature in-house NestJS service, not like modulegraph's other samples).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:consumers": "nest start -- user-record-data-updated,user-record-created,comment-added,tag-added",
    "start:stale-review-poller": "nest start -- stale-review-poller",
    "start:record-status-backfill": "nest start -- record-status-backfill",
    "start:duplicate-scan": "nest start -- duplicate-scan",
    "start:audit-log-retention": "nest start -- audit-log-retention",
    "start:manual-data-reencrypt": "nest start -- manual-data-reencrypt",
    "start:escalation-digest": "nest start -- escalation-digest",
    "start:tag-cleanup": "nest start -- tag-cleanup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@acme/nestjs-kafkajs": "file:../packages/acme-nestjs-kafkajs/acme-nestjs-kafkajs-3.0.0.tgz",
    "@acme/nestjs-logging": "file:../packages/acme-nestjs-logging/acme-nestjs-logging-4.0.2.tgz",
    "@acme/typeorm-outbox-writer": "file:../packages/acme-typeorm-outbox-writer/acme-typeorm-outbox-writer-2.0.0.tgz",
    "@aws-sdk/client-kms": "^3.700.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kafkajs": "^2.2.4",
    "minimist": "^1.2.8",
    "mysql2": "^3.11.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "glob": "^10.5.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
